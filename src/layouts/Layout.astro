---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = '1D Thermal Network Calculator',
	description = 'Build a series network of materials, air gaps, bonds and reflective surfaces and calculate steady-state heat flux and node temperatures entirely in your browser.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f5f7fa" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0e141a" media="(prefers-color-scheme: dark)" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light;
		--font-sans:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
			'Helvetica Neue', Arial, sans-serif;
		--font-mono:
			ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono',
			monospace;
		--bg: #f5f7fa;
		--glow-hot: rgba(247, 103, 7, 0.14);
		--glow-cool: rgba(25, 113, 194, 0.09);
		--panel: #ffffff;
		--panel-soft: #f8fafc;
		--text: #18212b;
		--muted: #637083;
		--border: #e0e6ed;
		--border-strong: #c7d0dc;
		--accent: #d9480f;
		--accent-2: #e8930c;
		--accent-soft: #fff2e8;
		--accent-glow: rgba(247, 103, 7, 0.13);
		--accent-ring: rgba(217, 72, 15, 0.18);
		--cool: #1971c2;
		--layer: #0b7285;
		--layer-soft: #e3fafc;
		--neutral-dot: #868e96;
		--success: #2b8a3e;
		--success-soft: #ebfbee;
		--warning: #a84e00;
		--warning-soft: #fff4e6;
		--warning-ring: #ffd8a8;
		--danger: #c92a2a;
		--danger-soft: #fff5f5;
		--danger-ring: #ffc9c9;
		--shadow: 0 24px 60px -40px rgba(21, 42, 69, 0.45);
		--radius: 18px;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			color-scheme: dark;
			--bg: #0e141a;
			--glow-hot: rgba(247, 103, 7, 0.14);
			--glow-cool: rgba(34, 139, 230, 0.1);
			--panel: #151c24;
			--panel-soft: #1a222b;
			--text: #e9eef5;
			--muted: #9aa8b8;
			--border: #28323d;
			--border-strong: #3a4756;
			--accent: #ff8a4c;
			--accent-2: #ffc078;
			--accent-soft: #2a1a12;
			--accent-glow: rgba(255, 138, 76, 0.12);
			--accent-ring: rgba(255, 138, 76, 0.25);
			--cool: #74c0fc;
			--layer: #63e6be;
			--layer-soft: #10261f;
			--neutral-dot: #adb5bd;
			--success: #69db7c;
			--success-soft: #14251a;
			--warning: #ffc078;
			--warning-soft: #2b2214;
			--warning-ring: #5c431e;
			--danger: #ff8787;
			--danger-soft: #2b1618;
			--danger-ring: #5c2a2e;
			--shadow: 0 30px 70px -48px rgba(0, 0, 0, 0.9);
		}
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		min-height: 100%;
		background: var(--bg);
	}

	body {
		min-height: 100vh;
		margin: 0;
		color: var(--text);
		background-color: var(--bg);
		background-image:
			radial-gradient(1100px 620px at 88% -10%, var(--glow-hot), transparent 64%),
			radial-gradient(860px 540px at 2% 24%, var(--glow-cool), transparent 60%);
		background-attachment: fixed;
		font-family: var(--font-sans);
		font-size: 16px;
		line-height: 1.5;
		text-rendering: optimizeLegibility;
		-webkit-font-smoothing: antialiased;
	}

	button,
	input,
	select,
	textarea {
		font-family: inherit;
	}

	::selection {
		background: var(--accent-ring);
	}
</style>
