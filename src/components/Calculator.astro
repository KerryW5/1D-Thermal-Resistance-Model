---
import {
	ADVANCED_DEFAULTS,
	DEFAULT_TEMPLATE_ID,
	NETWORK_TEMPLATES,
	TRANSIENT_DEFAULTS,
} from '../lib/networkConfig.ts';

const defaultTemplate = NETWORK_TEMPLATES.find((template) => template.id === DEFAULT_TEMPLATE_ID);
---

<section class="thermal-app" id="thermal-calculator">
	<header class="app-header">
		<div class="brand-line">
			<span class="brand-mark" aria-hidden="true">
				<svg viewBox="0 0 48 48" fill="none">
					<rect width="48" height="48" rx="14" fill="url(#brand-gradient)"></rect>
					<path
						d="M11 31c3.25 0 3.25-8 6.5-8s3.25 8 6.5 8 3.25-8 6.5-8 3.25 8 6.5 8"
						stroke="white"
						stroke-width="2.6"
						stroke-linecap="round"
					></path>
					<path
						d="M11 20h26"
						stroke="white"
						stroke-width="2.4"
						stroke-linecap="round"
						stroke-opacity="0.55"
					></path>
					<defs>
						<linearGradient id="brand-gradient" x1="4" y1="4" x2="44" y2="44" gradientUnits="userSpaceOnUse">
							<stop stop-color="#f76707"></stop>
							<stop offset="1" stop-color="#c2410c"></stop>
						</linearGradient>
					</defs>
				</svg>
			</span>
			<span class="eyebrow">Series thermal network · per unit area</span>
		</div>
		<h1>1D Thermal Network Calculator</h1>
		<p class="lede">
			Build a chain of materials, air gaps, bonds and surface finishes. Solve the steady-state
			temperatures, or step the thermal masses forward in time from t = 0.
		</p>
		<ul class="feature-tags" aria-label="Calculator features">
			<li>Node-based stack</li>
			<li>Steady state + transient</li>
			<li>Air gaps, bonds &amp; adhesive</li>
			<li>Reflective surfaces</li>
			<li>Runs locally</li>
		</ul>
	</header>

	<div class="calculator-grid">
		<form class="panel inputs-panel" id="network-form" novalidate>
			<div class="panel-heading">
				<div>
					<h2>Network setup</h2>
					<p class="panel-subtitle">Source, material layers and ambient sink</p>
				</div>
				<span class="panel-badge">Series</span>
			</div>

			<div class="model-bar">
				<div class="model-switcher" role="group" aria-label="Calculation model">
					<button
						type="button"
						class="model-option is-active"
						data-model-mode="steady"
						aria-pressed="true"
					>
						Steady state
					</button>
					<button
						type="button"
						class="model-option"
						data-model-mode="transient"
						aria-pressed="false"
					>
						Transient
					</button>
				</div>
				<p class="model-note" id="model-note">
					Solve the network until every node temperature converges.
				</p>
			</div>

			<section class="transient-settings" id="transient-settings" hidden>
				<div class="transient-heading">
					<h3>Time stepping</h3>
					<span id="transient-step-summary">
						Δt {TRANSIENT_DEFAULTS.timeStepS} s · 0 to {TRANSIENT_DEFAULTS.finalTimeS} s
					</span>
				</div>
				<div class="field-grid">
					<div class="field">
						<div class="field-label-row">
							<label for="timeStepS">Time step</label>
							<span class="unit">s</span>
						</div>
						<input
							id="timeStepS"
							data-path="timeStepS"
							type="number"
							value={TRANSIENT_DEFAULTS.timeStepS}
							step="0.1"
							min="0.000001"
							inputmode="decimal"
							aria-describedby="help-timeStepS"
						/>
						<p class="field-help" id="help-timeStepS">
							Output interval. The backward-Euler step remains stable for stiff materials.
						</p>
					</div>
					<div class="field">
						<div class="field-label-row">
							<label for="finalTimeS">Final time</label>
							<span class="unit">s</span>
						</div>
						<input
							id="finalTimeS"
							data-path="finalTimeS"
							type="number"
							value={TRANSIENT_DEFAULTS.finalTimeS}
							step="1"
							min="0.000001"
							inputmode="decimal"
							aria-describedby="help-finalTimeS"
						/>
						<p class="field-help" id="help-finalTimeS">
							End of the transient run. The last output lands exactly here.
						</p>
					</div>
					<div class="field field-span-full">
						<div class="field-label-row">
							<label for="initialTemperatureC">Initial layer temperature</label>
							<span class="unit">°C</span>
						</div>
						<input
							id="initialTemperatureC"
							data-path="initialTemperatureC"
							type="number"
							value={TRANSIENT_DEFAULTS.initialTemperatureC}
							step="1"
							min="-273.14"
							inputmode="decimal"
							aria-describedby="help-initialTemperatureC"
						/>
						<p class="field-help" id="help-initialTemperatureC">
							All layer nodes start here at t = 0. Source and ambient remain fixed.
						</p>
					</div>
				</div>
			</section>

			<div class="template-bar">
				<div class="field">
					<div class="field-label-row">
						<label for="template-select">Network template</label>
						<span class="unit">preset</span>
					</div>
					<select id="template-select">
						{NETWORK_TEMPLATES.map((template) => (
							<option value={template.id} selected={template.id === DEFAULT_TEMPLATE_ID}>
								{template.name}
							</option>
						))}
						<option value="custom">Custom network</option>
					</select>
				</div>
				<p class="template-description" id="template-description">
					{defaultTemplate?.description}
				</p>
			</div>

			<div
				class="chain"
				id="chain-container"
				role="group"
				aria-label="Series thermal network nodes"
			>
				<div class="chain-loading">Building network…</div>
			</div>

			<details class="advanced" id="advanced-settings">
				<summary>
					<span class="summary-title">Advanced settings</span>
					<span class="summary-hint" id="advanced-hint">Foil, air fit, gap convection, solver</span>
					<span class="chevron" aria-hidden="true"></span>
				</summary>

				<div class="advanced-body">
					<fieldset class="input-group">
						<legend>Surface &amp; air properties</legend>
						<div class="field-grid">
							<div class="field">
								<div class="field-label-row">
									<label for="foilEmissivity">Reflective foil emissivity</label>
									<span class="unit">ε<sub>foil</sub></span>
								</div>
								<input
									id="foilEmissivity"
									data-path="foilEmissivity"
									type="number"
									value={ADVANCED_DEFAULTS.foilEmissivity}
									step="0.01"
									min="0.001"
									max="1"
									inputmode="decimal"
									aria-describedby="help-foilEmissivity"
								/>
								<p class="field-help" id="help-foilEmissivity">
									Used wherever a surface finish is set to reflective foil.
								</p>
							</div>

							<div class="field">
								<div class="field-label-row">
									<label for="airFitIntercept">Air-fit intercept</label>
									<span class="unit">W/(m·K)</span>
								</div>
								<input
									id="airFitIntercept"
									data-path="airFitIntercept"
									type="number"
									value={ADVANCED_DEFAULTS.airFitIntercept}
									step="0.0001"
									min="0.000001"
									inputmode="decimal"
									aria-describedby="help-airFitIntercept"
								/>
								<p class="field-help" id="help-airFitIntercept">
									k<sub>air</sub> = intercept + slope · T[°C].
								</p>
							</div>

							<div class="field">
								<div class="field-label-row">
									<label for="airFitSlope">Air-fit slope</label>
									<span class="unit">W/(m·K·°C)</span>
								</div>
								<input
									id="airFitSlope"
									data-path="airFitSlope"
									type="number"
									value={ADVANCED_DEFAULTS.airFitSlope}
									step="0.000001"
									min="0"
									inputmode="decimal"
									aria-describedby="help-airFitSlope"
								/>
								<p class="field-help" id="help-airFitSlope">
									The source fit is intended for roughly 300–900 K.
								</p>
							</div>

							<div class="field">
								<div class="field-label-row">
									<label for="gapConvectionFactor">Air-gap convection factor</label>
									<span class="unit">×</span>
								</div>
								<input
									id="gapConvectionFactor"
									data-path="gapConvectionFactor"
									type="number"
									value={ADVANCED_DEFAULTS.gapConvectionFactor}
									step="0.05"
									min="0.000001"
									inputmode="decimal"
									aria-describedby="help-gapConvectionFactor"
								/>
								<p class="field-help" id="help-gapConvectionFactor">
									Multiplies the air-side conductance in every air gap. Radiation is
									unchanged and the ambient back boundary is not affected.
								</p>
							</div>
						</div>
					</fieldset>

					<fieldset class="input-group" id="steady-solver-settings">
						<legend>Solver</legend>
						<div class="field-grid">
							<div class="field">
								<div class="field-label-row">
									<label for="toleranceK">Convergence tolerance</label>
									<span class="unit">K</span>
								</div>
								<input
									id="toleranceK"
									data-path="toleranceK"
									type="number"
									value={ADVANCED_DEFAULTS.toleranceK}
									step="any"
									min="0.000000001"
									inputmode="decimal"
									aria-describedby="help-toleranceK"
								/>
								<p class="field-help" id="help-toleranceK">
									Maximum node-temperature change between iterations.
								</p>
							</div>

							<div class="field">
								<div class="field-label-row">
									<label for="maxIterations">Maximum iterations</label>
									<span class="unit">iter</span>
								</div>
								<input
									id="maxIterations"
									data-path="maxIterations"
									type="number"
									value={ADVANCED_DEFAULTS.maxIterations}
									step="1"
									min="1"
									max="100000"
									inputmode="numeric"
									aria-describedby="help-maxIterations"
								/>
								<p class="field-help" id="help-maxIterations">
									Upper limit for the fixed-point loop.
								</p>
							</div>

							<div class="field">
								<div class="field-label-row">
									<label for="relaxation">Relaxation factor</label>
									<span class="unit">0–1</span>
								</div>
								<input
									id="relaxation"
									data-path="relaxation"
									type="number"
									value={ADVANCED_DEFAULTS.relaxation}
									step="0.01"
									min="0.01"
									max="1"
									inputmode="decimal"
									aria-describedby="help-relaxation"
								/>
								<p class="field-help" id="help-relaxation">
									Damping applied to temperature updates.
								</p>
							</div>
						</div>
					</fieldset>
				</div>
			</details>

			<div class="form-actions">
				<button class="button button-primary" type="button" id="copy-button" disabled>
					Copy results
				</button>
				<button class="button button-ghost" type="button" id="reset-button">Reset demo</button>
			</div>

			<p class="privacy-note">
				<span class="privacy-dot" aria-hidden="true"></span>
				All calculations run in your browser. No data is sent to a server.
			</p>
		</form>

		<section
			class="panel results-panel"
			id="results-panel"
			data-state="loading"
			aria-busy="true"
		>
			<div class="panel-heading">
				<div>
					<h2>Results</h2>
					<p class="panel-subtitle" id="results-subtitle">Live steady-state solution</p>
				</div>
				<span class="live-pill"><span aria-hidden="true"></span>Live</span>
			</div>

			<div class="error-banner" id="error-banner" role="alert" hidden></div>
			<noscript>
				<p class="noscript-note">
					JavaScript is required to build the node network and calculate results.
				</p>
			</noscript>

			<div class="results-content" id="results-content">
				<div id="results-dynamic">
					<div class="results-placeholder">Calculating the steady-state network…</div>
				</div>

				<details class="method">
					<summary>Model assumptions &amp; equations</summary>
					<div class="method-body">
						<p>
							Material layers are conduction resistances in series. Every connection between the
							source, layers and ambient contributes its own resistance. In steady-state mode heat
							flux is constant through the stack unless an air gap removes an assumed airflow
							dissipation.
						</p>
						<div class="formula-list">
							<code>q″ = (T<sub>hot</sub> − T<sub>∞</sub>) / Σ R″</code>
							<code>R″<sub>layer</sub> = L<sub>layer</sub> / k<sub>layer</sub></code>
							<code>R″<sub>air gap</sub> = [ L<sub>gap</sub> / k<sub>air</sub>(T<sub>mean</sub>) ∥ 1 / h<sub>rad,gap</sub> ]</code>
							<code>q″<sub>after gap</sub> = q″<sub>before gap</sub> − D<sub>gap</sub></code>
							<code>R″<sub>adhesive</sub> = L<sub>adhesive</sub> / k<sub>adhesive</sub></code>
							<code>R″<sub>back</sub> = [ 1 / h<sub>conv,back</sub> ∥ 1 / h<sub>rad,back</sub> ]</code>
							<code>h<sub>rad</sub> = σ ε<sub>eff</sub> (T<sub>a</sub>² + T<sub>b</sub>²)(T<sub>a</sub> + T<sub>b</sub>)</code>
						</div>
						<p>
							In transient mode each layer receives a thermal capacitance per unit area,
							<code>C″ = ρ c<sub>p</sub> L</code>, split equally between its front and back nodes.
							The solver advances all node temperatures from the specified initial temperature using
							backward Euler at the selected time step.
						</p>
						<div class="formula-list">
							<code>C″ = ρ c<sub>p</sub> L ; C″<sub>front</sub> = C″<sub>back</sub> = C″ / 2</code>
							<code>C″<sub>i</sub> (T<sub>i</sub><sup>n+1</sup> − T<sub>i</sub><sup>n</sup>) / Δt = Σ G<sub>ij</sub>(T<sub>j</sub><sup>n+1</sup> − T<sub>i</sub><sup>n+1</sup>)</code>
						</div>
						<ul class="assumption-list">
							<li>Bonded connections have zero thermal resistance.</li>
							<li>Contact-resistance connections use the specified R″ directly.</li>
							<li>Air gaps combine stagnant-air conduction with linearised parallel-plate radiation.</li>
							<li>Each air gap can remove an assumed airflow dissipation D<sub>gap</sub>; the downstream heat flux is reduced by that amount.</li>
							<li>The global air-gap convection factor scales the air-side conductance of every gap; radiation and the ambient back boundary are unaffected.</li>
							<li>Bare surfaces use the material emissivity, reflective foil uses the global foil ε, and custom surfaces use the entered ε.</li>
							<li>The air conductivity fit is a linear approximation intended for roughly 300–900 K.</li>
							<li>Steady-state node temperatures use damped fixed-point iteration.</li>
							<li>Transient mode uses implicit backward Euler with temperature-dependent resistances lagged at each step; it is stable at the selected time step.</li>
							<li>Transient ΔT values are instantaneous surface differences at the final time, not steady-state drops.</li>
						</ul>
						<p class="model-reference">
							Reference implementations: <code>source_model/model.py</code> and
							<code>source_model/transient_model.py</code>. The source-model template reproduces the
							single-layer steady-state benchmark.
						</p>
					</div>
				</details>

				<p class="sr-only" id="live-summary" aria-live="polite" aria-atomic="true"></p>
			</div>
		</section>
	</div>

	<footer class="app-footer">
		<p>Based on the Python steady-state and transient models. The solvers are fully client-side.</p>
		<p>Static-host ready · No server required</p>
	</footer>
</section>

<script>
	import {
		MAX_LAYERS,
		effectiveGapEmissivity,
		solveThermalNetwork,
		solveTransientNetwork,
		type InterfaceType,
		type NetworkInputs,
		type NetworkSnapshot,
		type ThermalNetworkResult,
		type TransientNetworkResult,
		type ValidationIssue,
	} from '../lib/thermalModel.ts';
	import {
		DEFAULT_TEMPLATE_ID,
		INTERFACE_TYPE_LABELS,
		INTERFACE_TYPE_OPTIONS,
		MATERIAL_PRESETS,
		SURFACE_FINISH_OPTIONS,
		applyMaterialToLayer,
		applyTemplate,
		buildNetworkInputs,
		createInitialState,
		createInterface,
		createLayer,
		getTemplate,
		resolveSurfaceEmissivity,
		validateNetworkState,
		type LayerState,
		type ModelMode,
		type NetworkState,
		type SurfaceState,
	} from '../lib/networkConfig.ts';

	const SVG_NS = 'http://www.w3.org/2000/svg';
	const ADVANCED_PATHS = new Set([
		'foilEmissivity',
		'airFitIntercept',
		'airFitSlope',
		'gapConvectionFactor',
		'toleranceK',
		'maxIterations',
		'relaxation',
	]);
	const SIMULATION_PATHS = new Set(['timeStepS', 'finalTimeS', 'initialTemperatureC']);

	type LastRun =
		| { mode: 'steady'; result: ThermalNetworkResult; inputs: NetworkInputs }
		| { mode: 'transient'; result: TransientNetworkResult; inputs: NetworkInputs };

	let state = createInitialState(DEFAULT_TEMPLATE_ID);
	let lastRun: LastRun | null = null;
	let scheduledFrame = 0;
	let copyTimer = 0;

	const fixedOne = new Intl.NumberFormat('en-US', {
		minimumFractionDigits: 1,
		maximumFractionDigits: 1,
	});
	const fixedTwo = new Intl.NumberFormat('en-US', {
		minimumFractionDigits: 2,
		maximumFractionDigits: 2,
	});
	const fixedThree = new Intl.NumberFormat('en-US', {
		minimumFractionDigits: 3,
		maximumFractionDigits: 3,
	});
	const fixedFour = new Intl.NumberFormat('en-US', {
		minimumFractionDigits: 4,
		maximumFractionDigits: 4,
	});
	const lengthFormat = new Intl.NumberFormat('en-US', {
		maximumFractionDigits: 3,
	});
	const timeFormat = new Intl.NumberFormat('en-US', {
		maximumFractionDigits: 3,
	});
	const significant = new Intl.NumberFormat('en-US', {
		maximumSignificantDigits: 4,
	});

	const form = byId<HTMLFormElement>('network-form');
	const chainContainer = byId<HTMLElement>('chain-container');
	const resultsDynamic = byId<HTMLElement>('results-dynamic');
	const resultsContent = byId<HTMLElement>('results-content');
	const resultsPanel = byId<HTMLElement>('results-panel');
	const errorBanner = byId<HTMLElement>('error-banner');
	const copyButton = byId<HTMLButtonElement>('copy-button');
	const resetButton = byId<HTMLButtonElement>('reset-button');
	const templateSelect = byId<HTMLSelectElement>('template-select');
	const templateDescription = byId<HTMLElement>('template-description');
	const advanced = byId<HTMLDetailsElement>('advanced-settings');
	const liveSummary = byId<HTMLElement>('live-summary');
	const modelNote = byId<HTMLElement>('model-note');
	const transientSettings = byId<HTMLElement>('transient-settings');
	const transientStepSummary = byId<HTMLElement>('transient-step-summary');
	const resultsSubtitle = byId<HTMLElement>('results-subtitle');
	const advancedHint = byId<HTMLElement>('advanced-hint');
	const steadySolverSettings = byId<HTMLElement>('steady-solver-settings');
	const modelButtons = Array.from(
		document.querySelectorAll<HTMLButtonElement>('[data-model-mode]'),
	);

	function byId<T extends HTMLElement | SVGElement>(id: string): T {
		const element = document.getElementById(id);
		if (!element) {
			throw new Error(`Missing element #${id}`);
		}
		return element as T;
	}

	function escapeHtml(value: string): string {
		return value.replace(/[&<>"']/g, (character) => {
			switch (character) {
				case '&':
					return '&amp;';
				case '<':
					return '&lt;';
				case '>':
					return '&gt;';
				case '"':
					return '&quot;';
				default:
					return '&#39;';
			}
		});
	}

	function numberInputValue(value: number): string {
		return Number.isFinite(value) ? String(value) : '';
	}

	function formatFlux(value: number): string {
		return Number.isFinite(value) ? fixedOne.format(value) : '—';
	}

	function formatTemperature(value: number): string {
		return Number.isFinite(value) ? fixedTwo.format(value) : '—';
	}

	function formatDelta(value: number): string {
		return Number.isFinite(value) ? `${fixedOne.format(value)} K` : '—';
	}

	function formatResistance(value: number): string {
		if (!Number.isFinite(value)) {
			return '—';
		}
		if (value === 0) {
			return '0';
		}
		const magnitude = Math.abs(value);
		if (magnitude < 1e-4 || magnitude >= 1e5) {
			return value.toExponential(3);
		}
		return significant.format(value);
	}

	function formatPercent(fraction: number): string {
		return Number.isFinite(fraction) ? `${fixedOne.format(fraction * 100)}%` : '—';
	}

	function formatProperty(value: number): string {
		return Number.isFinite(value) ? significant.format(value) : '—';
	}

	function formatEmissivity(value: number): string {
		return Number.isFinite(value) ? fixedFour.format(value) : '—';
	}

	function formatLength(valueMm: number): string {
		return Number.isFinite(valueMm) ? lengthFormat.format(valueMm) : '—';
	}

	function formatTime(valueS: number): string {
		return Number.isFinite(valueS) ? timeFormat.format(valueS) : '—';
	}

	function formatResidual(value: number): string {
		if (!Number.isFinite(value)) {
			return '—';
		}
		if (value === 0) {
			return '0';
		}
		if (value < 0.001) {
			return value.toExponential(1);
		}
		return significant.format(value);
	}

	function findByPath(path: string): HTMLElement | null {
		const elements = Array.from(form.querySelectorAll<HTMLElement>('[data-path]'));
		return elements.find((element) => element.dataset.path === path) ?? null;
	}

	function setValueAtPath(root: unknown, path: string, value: unknown): void {
		const parts = path.split('.');
		let current = root as Record<string, unknown>;
		for (let index = 0; index < parts.length - 1; index += 1) {
			const next = current[parts[index]];
			if (!next || typeof next !== 'object') {
				return;
			}
			current = next as Record<string, unknown>;
		}
		current[parts[parts.length - 1]] = value;
	}

	function layerIndexFromMaterialPath(path: string): number | null {
		const match = path.match(/^layers\.(\d+)\.materialId$/);
		return match ? Number(match[1]) : null;
	}

	function sourceEffectiveEmissivity(): number {
		return resolveSurfaceEmissivity(
			state.sourceSurface,
			state.sourceBareEmissivity,
			state.foilEmissivity,
		);
	}

	function layerFrontEmissivity(index: number): number {
		const layer = state.layers[index];
		if (!layer) {
			return Number.NaN;
		}
		return resolveSurfaceEmissivity(layer.frontSurface, layer.bareEmissivity, state.foilEmissivity);
	}

	function layerBackEmissivity(index: number): number {
		const layer = state.layers[index];
		if (!layer) {
			return Number.NaN;
		}
		return resolveSurfaceEmissivity(layer.backSurface, layer.bareEmissivity, state.foilEmissivity);
	}

	function gapSurfaces(index: number): { upstream: number; downstream: number } {
		return {
			upstream: index === 0 ? sourceEffectiveEmissivity() : layerBackEmissivity(index - 1),
			downstream: layerFrontEmissivity(index),
		};
	}

	function gapEffectiveEmissivity(index: number): number {
		const surfaces = gapSurfaces(index);
		if (
			!Number.isFinite(surfaces.upstream) ||
			!Number.isFinite(surfaces.downstream) ||
			surfaces.upstream <= 0 ||
			surfaces.upstream > 1 ||
			surfaces.downstream <= 0 ||
			surfaces.downstream > 1
		) {
			return Number.NaN;
		}
		return effectiveGapEmissivity(surfaces.upstream, surfaces.downstream);
	}

	function optionsHtml(
		options: ReadonlyArray<{ value: string; label: string }>,
		selected: string,
	): string {
