		color: var(--muted);
		font-size: 0.68rem;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.thermal-app input[type='number'] {
		width: 100%;
		min-height: 42px;
		padding: 9px 11px;
		border: 1px solid var(--border-strong);
		border-radius: 10px;
		background: var(--panel-soft);
		color: var(--text);
		font: inherit;
		font-size: 0.94rem;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		transition:
			border-color 160ms ease,
			box-shadow 160ms ease,
			background-color 160ms ease;
	}

	.thermal-app input[type='number']:hover {
		border-color: color-mix(in srgb, var(--border-strong), var(--text) 18%);
	}

	.thermal-app input[type='number']:focus-visible {
		outline: none;
		border-color: var(--accent);
		background: var(--panel);
		box-shadow: 0 0 0 3px var(--accent-ring);
	}

	.thermal-app input[aria-invalid='true'] {
		border-color: var(--danger);
		background: var(--danger-soft);
	}

	.thermal-app input[aria-invalid='true']:focus-visible {
		box-shadow: 0 0 0 3px var(--danger-ring);
	}

	.thermal-app .field-help {
		margin: 5px 0 0;
		color: var(--muted);
		font-size: 0.7rem;
		line-height: 1.45;
	}

	.thermal-app .field-error {
		margin: 5px 0 0;
		color: var(--danger);
		font-size: 0.72rem;
		font-weight: 600;
		line-height: 1.45;
	}

	.thermal-app .advanced {
		margin-top: 4px;
		border-top: 1px solid var(--border);
		padding-top: 16px;
	}

	.thermal-app .advanced summary {
		display: flex;
		align-items: center;
		gap: 10px;
		cursor: pointer;
		list-style: none;
		color: var(--text);
		font-size: 0.87rem;
		font-weight: 700;
	}

	.thermal-app .advanced summary::-webkit-details-marker {
		display: none;
	}

	.thermal-app .summary-hint {
		margin-left: auto;
		color: var(--muted);
		font-size: 0.68rem;
		font-weight: 500;
	}

	.thermal-app .chevron {
		width: 8px;
		height: 8px;
		margin-right: 3px;
		border-right: 2px solid var(--muted);
		border-bottom: 2px solid var(--muted);
		transform: rotate(45deg);
		transition: transform 160ms ease;
	}

	.thermal-app .advanced[open] .chevron {
		transform: rotate(225deg) translate(-2px, -2px);
	}

	.thermal-app .advanced summary:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 4px;
		border-radius: 4px;
	}

	.thermal-app .advanced-body {
		padding-top: 20px;
	}

	.thermal-app .advanced-body .input-group:last-of-type {
		margin-bottom: 12px;
	}

	.thermal-app .fit-note,
	.thermal-app .computed-note {
		margin: 10px 0 0;
		color: var(--muted);
		font-size: 0.72rem;
		line-height: 1.5;
	}

	.thermal-app .computed-note {
		padding: 9px 11px;
		border: 1px dashed var(--border-strong);
		border-radius: 9px;
		background: var(--panel-soft);
	}

	.thermal-app .computed-note strong {
		color: var(--accent);
		font-variant-numeric: tabular-nums;
	}

	.thermal-app .form-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 22px;
	}

	.thermal-app .button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 42px;
		padding: 10px 16px;
		border: 1px solid transparent;
		border-radius: 10px;
		font: inherit;
		font-size: 0.83rem;
		font-weight: 700;
		cursor: pointer;
		transition:
			transform 140ms ease,
			box-shadow 140ms ease,
			background-color 140ms ease,
			border-color 140ms ease;
	}

	.thermal-app .button:active {
		transform: translateY(1px);
	}

	.thermal-app .button:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	.thermal-app .button:disabled {
		cursor: not-allowed;
		opacity: 0.55;
	}

	.thermal-app .button-primary {
		flex: 1 1 150px;
		color: #fff;
		background: linear-gradient(135deg, #f76707, #c2410c);
		box-shadow: 0 10px 22px -12px rgba(194, 65, 12, 0.75);
	}

	.thermal-app .button-primary:hover:not(:disabled) {
		box-shadow: 0 13px 26px -12px rgba(194, 65, 12, 0.9);
	}

	.thermal-app .button-ghost {
		flex: 0 1 auto;
		border-color: var(--border-strong);
		background: var(--panel-soft);
		color: var(--text);
	}

	.thermal-app .button-ghost:hover {
		border-color: var(--text);
	}

	.thermal-app .privacy-note {
		display: flex;
		align-items: center;
		gap: 7px;
		margin: 16px 0 0;
		color: var(--muted);
		font-size: 0.7rem;
		line-height: 1.45;
	}

	.thermal-app .privacy-dot {
		width: 6px;
		height: 6px;
		flex: none;
		border-radius: 50%;
		background: var(--success);
		box-shadow: 0 0 0 3px var(--success-soft);
	}

	.thermal-app .results-panel {
		min-width: 0;
	}

	.thermal-app .live-pill {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		flex: none;
		padding: 5px 10px;
		border-radius: 999px;
		background: var(--success-soft);
		color: var(--success);
		font-size: 0.67rem;
		font-weight: 750;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.thermal-app .live-pill > span {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: currentColor;
	}

	.thermal-app .error-banner {
		margin: 0 0 16px;
		padding: 11px 13px;
		border: 1px solid var(--danger-ring);
		border-radius: 10px;
		background: var(--danger-soft);
		color: var(--danger);
		font-size: 0.8rem;
		font-weight: 600;
		line-height: 1.5;
	}

	.thermal-app .noscript-note {
		margin: 0 0 16px;
		padding: 11px 13px;
		border: 1px solid var(--warning-ring);
		border-radius: 10px;
		background: var(--warning-soft);
		color: var(--warning);
		font-size: 0.8rem;
		line-height: 1.5;
	}

	.thermal-app .results-content {
		transition: opacity 180ms ease;
	}

	.thermal-app .results-content.is-stale {
		opacity: 0.45;
	}

	.thermal-app .result-hero {
		padding: 20px;
		border: 1px solid var(--border);
		border-radius: 14px;
		background:
			radial-gradient(120% 160% at 100% 0%, var(--accent-glow), transparent 58%),
			linear-gradient(135deg, var(--accent-soft), var(--panel-soft));
	}

	.thermal-app .hero-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 12px;
	}

	.thermal-app .result-label {
		margin: 0;
		color: var(--muted);
		font-size: 0.72rem;
		font-weight: 750;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.thermal-app .symbol {
		color: var(--accent);
		font-size: 0.85rem;
		letter-spacing: 0;
	}

	.thermal-app .hero-unit {
		color: var(--muted);
		font-size: 0.68rem;
		font-weight: 500;
	}

	.thermal-app .hero-value {
		display: flex;
		align-items: baseline;
		gap: 8px;
		margin: 4px 0 0;
		color: var(--text);
		font-size: clamp(2.4rem, 6vw, 3.7rem);
		font-weight: 780;
		line-height: 1;
		letter-spacing: -0.055em;
		font-variant-numeric: tabular-nums;
	}

	.thermal-app .hero-metric {
		color: var(--muted);
		font-size: 0.9rem;
		font-weight: 600;
		letter-spacing: 0;
	}

	.thermal-app .hero-secondary {
		margin: 6px 0 0;
		color: var(--muted);
		font-size: 0.77rem;
		font-weight: 500;
		font-variant-numeric: tabular-nums;
	}

	.thermal-app .temp-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
		margin-top: 12px;
	}

	.thermal-app .temp-card {
		min-width: 0;
		padding: 14px 16px;
		border: 1px solid var(--border);
		border-radius: 12px;
		background: var(--panel-soft);
	}

	.thermal-app .temp-card.is-hot {
		box-shadow: inset 3px 0 0 var(--accent);
	}

	.thermal-app .temp-card.is-cool {
		box-shadow: inset 3px 0 0 var(--cool);
	}

	.thermal-app .temp-label {
		margin: 0;
		color: var(--muted);
		font-size: 0.71rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.thermal-app .temp-value {
		display: flex;
		align-items: baseline;
		gap: 4px;
		margin: 4px 0 0;
		font-size: 1.65rem;
		font-weight: 750;
		line-height: 1;
		letter-spacing: -0.035em;
		font-variant-numeric: tabular-nums;
	}

	.thermal-app .temp-unit {
		color: var(--muted);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0;
	}

	.thermal-app .temp-meta {
		margin: 5px 0 0;
		color: var(--muted);
		font-size: 0.68rem;
	}

	.thermal-app .status-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		margin-top: 12px;
	}

	.thermal-app .status-badge {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		padding: 6px 10px;
		border-radius: 999px;
		font-size: 0.7rem;
		font-weight: 650;
		font-variant-numeric: tabular-nums;
	}

	.thermal-app .status-badge::before {
		content: '';
		width: 6px;
		height: 6px;
		flex: none;
		border-radius: 50%;
		background: currentColor;
	}

	.thermal-app .status-badge.is-success {
		background: var(--success-soft);
		color: var(--success);
	}

	.thermal-app .status-badge.is-warning {
		background: var(--warning-soft);
		color: var(--warning);
	}

	.thermal-app .status-note {
		color: var(--muted);
		font-size: 0.7rem;
		line-height: 1.45;
	}

	.thermal-app .status-note.is-warning {
		color: var(--warning);
		font-weight: 600;
	}

	.thermal-app .chart-card {
		margin: 18px 0 0;
		padding: 16px;
		border: 1px solid var(--border);
		border-radius: 14px;
		background: var(--panel-soft);
	}

	.thermal-app .chart-heading {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 12px;
	}

	.thermal-app .chart-heading h3 {
		margin: 0;
		font-size: 0.93rem;
		letter-spacing: -0.015em;
	}

	.thermal-app .chart-heading p {
		margin: 3px 0 0;
		color: var(--muted);
		font-size: 0.7rem;
	}

	.thermal-app .chart-unit {
		flex: none;
		padding: 3px 8px;
		border: 1px solid var(--border);
		border-radius: 999px;
		color: var(--muted);
		font-size: 0.66rem;
		font-weight: 650;
	}

	.thermal-app .resistance-bar {
		display: flex;
		width: 100%;
		height: 9px;
		margin-top: 14px;
		overflow: hidden;
		border-radius: 999px;
		background: var(--border);
	}

	.thermal-app .bar-segment {
		display: block;
		height: 100%;
		width: 0;
		transition: width 220ms ease;
	}

	.thermal-app .bar-segment.is-gap,
	.thermal-app .swatch.is-gap {
		background: var(--accent);
	}

	.thermal-app .bar-segment.is-plate,
	.thermal-app .swatch.is-plate {
		background: var(--accent-2);
	}

	.thermal-app .bar-segment.is-back,
	.thermal-app .swatch.is-back {
		background: var(--cool);
	}

	.thermal-app .bar-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 16px;
		margin-top: 9px;
		color: var(--muted);
		font-size: 0.69rem;
		font-variant-numeric: tabular-nums;
	}

	.thermal-app .bar-legend > span {
		display: inline-flex;
		align-items: center;
		gap: 5px;
	}

	.thermal-app .bar-legend strong {
		color: var(--text);
		font-weight: 650;
	}

	.thermal-app .swatch {
		width: 7px;
		height: 7px;
		border-radius: 2px;
	}

	.thermal-app #temp-chart {
		display: block;
		width: 100%;
		height: auto;
		margin-top: 4px;
		overflow: visible;
	}

	.thermal-app .chart-grid-line {
		stroke: var(--border);
		stroke-width: 1;
		stroke-dasharray: 3 4;
	}

	.thermal-app .chart-tick-label {
		fill: var(--muted);
		font-family: var(--font-sans);
		font-size: 10.5px;
		font-variant-numeric: tabular-nums;
	}

	.thermal-app #chart-area {
		fill: var(--accent);
		opacity: 0.075;
	}

	.thermal-app .chart-segment {
		stroke-width: 3;
		stroke-linecap: round;
	}

	.thermal-app .chart-segment.segment-gap {
		stroke: var(--accent);
	}

	.thermal-app .chart-segment.segment-plate {
		stroke: var(--accent-2);
	}

	.thermal-app .chart-segment.segment-back {
		stroke: var(--cool);
	}

	.thermal-app .chart-point {
		fill: var(--panel);
		stroke-width: 2.5;
	}

	.thermal-app .chart-point.point-hot {
		stroke: var(--accent);
	}

	.thermal-app .chart-point.point-warm {
		stroke: var(--accent-2);
	}

	.thermal-app .chart-point.point-cool {
		stroke: var(--cool);
	}

	.thermal-app .chart-point-label {
		fill: var(--text);
		font-family: var(--font-sans);
		font-size: 11px;
		font-weight: 650;
		font-variant-numeric: tabular-nums;
	}

	.thermal-app .chart-x-label {
		fill: var(--text);
		font-family: var(--font-sans);
		font-size: 10.5px;
		font-weight: 600;
	}

	.thermal-app .chart-x-sub {
		fill: var(--muted);
		font-family: var(--font-sans);
		font-size: 9.5px;
	}

	.thermal-app .chart-note {
		margin: 4px 0 0;
		color: var(--muted);
		font-size: 0.66rem;
		line-height: 1.5;
	}

	.thermal-app .breakdown {
		margin-top: 20px;
	}

	.thermal-app .section-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 12px;
		margin-bottom: 10px;
	}

	.thermal-app .section-heading h3 {
		margin: 0;
		font-size: 0.93rem;
		letter-spacing: -0.015em;
	}

	.thermal-app .section-heading > span {
		color: var(--muted);
		font-size: 0.66rem;
		font-weight: 600;
	}

	.thermal-app .table-wrap {
		overflow-x: auto;
		border: 1px solid var(--border);
		border-radius: 12px;
	}

	.thermal-app table {
		width: 100%;
		min-width: 440px;
		border-collapse: collapse;
		font-size: 0.81rem;
		font-variant-numeric: tabular-nums;
	}

	.thermal-app th,
	.thermal-app td {
		padding: 9px 11px;
		border-top: 1px solid var(--border);
		text-align: right;
		white-space: nowrap;
	}

	.thermal-app thead th {
		border-top: 0;
		background: var(--panel-soft);
		color: var(--muted);
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.thermal-app th:first-child,
	.thermal-app td:first-child {
		text-align: left;
	}

	.thermal-app tbody th {
		font-weight: 600;
		color: var(--text);
	}

	.thermal-app .sub-row th,
	.thermal-app .sub-row td {
		padding-top: 6px;
		padding-bottom: 6px;
		color: var(--muted);
		font-size: 0.73rem;
		font-weight: 500;
		background: color-mix(in srgb, var(--panel-soft) 45%, transparent);
	}

	.thermal-app .sub-row th {
		padding-left: 22px;
	}

	.thermal-app .total-row th,
	.thermal-app .total-row td {
		border-top: 2px solid var(--border-strong);
		background: var(--panel-soft);
		font-weight: 750;
	}

	.thermal-app .property-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 7px;
		margin-top: 11px;
	}

	.thermal-app .chip {
		display: inline-flex;
		align-items: baseline;
		gap: 4px;
		padding: 5px 9px;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--panel-soft);
		color: var(--muted);
		font-size: 0.67rem;
		font-variant-numeric: tabular-nums;
	}

	.thermal-app .chip strong {
		color: var(--text);
		font-weight: 700;
	}

	.thermal-app .method {
		margin-top: 20px;
		padding-top: 16px;
		border-top: 1px solid var(--border);
	}

	.thermal-app .method summary {
		cursor: pointer;
		color: var(--text);
		font-size: 0.84rem;
		font-weight: 700;
		list-style: none;
	}

	.thermal-app .method summary::-webkit-details-marker {
		display: none;
	}

	.thermal-app .method summary::before {
		content: '+';
		display: inline-block;
		width: 16px;
		color: var(--accent);
		font-weight: 750;
	}

	.thermal-app .method[open] summary::before {
		content: '−';
	}

	.thermal-app .method summary:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 4px;
		border-radius: 4px;
	}

	.thermal-app .method-body {
		padding-top: 12px;
		color: var(--muted);
		font-size: 0.77rem;
		line-height: 1.6;
	}

	.thermal-app .method-body p {
		margin: 0 0 10px;
	}

	.thermal-app .formula-list {
		display: grid;
		gap: 6px;
		margin: 10px 0 12px;
	}

	.thermal-app .formula-list code {
		display: block;
		padding: 8px 10px;
		overflow-x: auto;
		border: 1px solid var(--border);
		border-radius: 8px;
		background: var(--panel-soft);
		color: var(--text);
		font-size: 0.71rem;
		white-space: nowrap;
	}

	.thermal-app .assumption-list {
		margin: 0 0 12px;
		padding-left: 18px;
	}

	.thermal-app .assumption-list li {
		margin-bottom: 4px;
	}

	.thermal-app .model-reference {
		margin-bottom: 0 !important;
		font-size: 0.7rem;
	}

	.thermal-app .app-footer {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 8px 20px;
		margin-top: 26px;
		padding-top: 16px;
		border-top: 1px solid var(--border);
		color: var(--muted);
		font-size: 0.7rem;
	}

	.thermal-app .app-footer p {
		margin: 0;
	}

	.thermal-app .app-footer p:last-child {
		font-weight: 600;
	}

	.thermal-app .sr-only {
		position: absolute !important;
		width: 1px !important;
		height: 1px !important;
		padding: 0 !important;
		margin: -1px !important;
		overflow: hidden !important;
		clip: rect(0, 0, 0, 0) !important;
		white-space: nowrap !important;
		border: 0 !important;
	}

	@media (max-width: 900px) {
		.thermal-app {
			padding: 30px 18px 40px;
		}

		.thermal-app .calculator-grid {
			grid-template-columns: minmax(0, 1fr);
		}

		.thermal-app .panel {
			padding: 20px;
		}
	}

	@media (max-width: 560px) {
		.thermal-app {
			padding: 24px 12px 32px;
		}

		.thermal-app .field-grid {
			grid-template-columns: minmax(0, 1fr);
		}

		.thermal-app .temp-grid {
			grid-template-columns: minmax(0, 1fr);
		}

		.thermal-app .summary-hint {
			display: none;
		}

		.thermal-app .hero-value {
			font-size: clamp(2.2rem, 13vw, 3rem);
		}

		.thermal-app .chart-card {
			padding: 12px;
		}

		.thermal-app .panel {
			padding: 18px 16px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.thermal-app *,
		.thermal-app *::before,
		.thermal-app *::after {
			scroll-behavior: auto !important;
			transition-duration: 0.01ms !important;
			animation-duration: 0.01ms !important;
