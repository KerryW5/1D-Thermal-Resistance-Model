	function renderChain(): void {
		const cards: string[] = [sourceCardHtml()];
		state.layers.forEach((layer, index) => {
			const networkInterface =
				state.interfaces[index] ?? createInterface('bonded');
			cards.push(interfaceCardHtml(networkInterface, index));
			cards.push(layerCardHtml(layer, index));
		});
		cards.push(addLayerButtonHtml());
		cards.push(ambientCardHtml());
		chainContainer.innerHTML = cards.join('');
	}

	function setComputed(key: string, text: string): void {
		const elements = form.querySelectorAll<HTMLElement>(`[data-computed="${key}"]`);
		elements.forEach((element) => {
			element.textContent = text;
		});
	}

	function updateComputedHints(): void {
		setComputed('source-surface-bare', formatEmissivity(state.sourceBareEmissivity));
		setComputed('source-surface-effective', formatEmissivity(sourceEffectiveEmissivity()));

		state.layers.forEach((layer, index) => {
			setComputed(`layer-${index}-front-bare`, formatEmissivity(layer.bareEmissivity));
			setComputed(`layer-${index}-back-bare`, formatEmissivity(layer.bareEmissivity));
			setComputed(`layer-${index}-front-effective`, formatEmissivity(layerFrontEmissivity(index)));
			setComputed(`layer-${index}-back-effective`, formatEmissivity(layerBackEmissivity(index)));
		});

		state.interfaces.forEach((networkInterface, index) => {
			if (networkInterface.type !== 'air-gap') {
				return;
			}
			const surfaces = gapSurfaces(index);
			setComputed(`gap-${index}-up`, formatEmissivity(surfaces.upstream));
			setComputed(`gap-${index}-down`, formatEmissivity(surfaces.downstream));
			setComputed(`gap-${index}-eff`, formatEmissivity(gapEffectiveEmissivity(index)));
		});

		const lastLayer = state.layers[state.layers.length - 1];
		setComputed(
			'ambient-back-effective',
			formatEmissivity(
				lastLayer ? layerBackEmissivity(state.layers.length - 1) : Number.NaN,
			),
		);
	}

	function updateTemplateDescription(): void {
		const template = getTemplate(state.templateId);
		templateDescription.textContent = template
			? template.description
			: 'Custom network — edit any node, connection or surface finish.';
	}

	function updateModelControls(): void {
		const transient = state.modelMode === 'transient';
		modelButtons.forEach((button) => {
			const active = button.dataset.modelMode === state.modelMode;
			button.classList.toggle('is-active', active);
			button.setAttribute('aria-pressed', String(active));
		});
		transientSettings.hidden = !transient;
		steadySolverSettings.hidden = transient;
		advancedHint.textContent = transient
			? 'Foil, air fit, gap convection'
			: 'Foil, air fit, gap convection, solver';
		resultsSubtitle.textContent = transient
			? 'Live transient time history'
			: 'Live steady-state solution';
		modelNote.textContent = transient
			? `Advance the thermal masses from t = 0 to ${formatTime(state.finalTimeS)} s in ${formatTime(state.timeStepS)} s steps. Source and ambient boundaries stay fixed.`
			: 'Solve the network until every node temperature converges.';
		transientStepSummary.textContent = `Δt ${formatTime(state.timeStepS)} s · 0 to ${formatTime(state.finalTimeS)} s`;
	}

	function markCustomNetwork(): void {
		if (state.templateId === 'custom') {
			return;
		}
		state.templateId = 'custom';
		templateSelect.value = 'custom';
		updateTemplateDescription();
	}

	function clearErrors(): void {
		form.querySelectorAll('.field-error').forEach((element) => element.remove());
		form.querySelectorAll<HTMLElement>('[data-path]').forEach((element) => {
			element.removeAttribute('aria-invalid');
			const help = element.closest('.field')?.querySelector<HTMLElement>('.field-help');
			if (help?.id) {
				element.setAttribute('aria-describedby', help.id);
			} else {
				element.removeAttribute('aria-describedby');
			}
		});
	}

	function errorIdForPath(path: string): string {
		return `error-${path.replace(/[^a-zA-Z0-9_-]/g, '-')}`;
	}

	function showErrors(issues: ValidationIssue[]): void {
		clearErrors();
		let hasAdvancedIssue = false;
		for (const issue of issues) {
			const input = findByPath(issue.path);
			if (!input) {
				continue;
			}
			input.setAttribute('aria-invalid', 'true');
			const field = input.closest('.field');
			if (!field) {
				continue;
			}
			const error = document.createElement('p');
			error.className = 'field-error';
			error.id = errorIdForPath(issue.path);
			error.textContent = issue.message;
			field.append(error);
			const help = field.querySelector<HTMLElement>('.field-help');
			const describedBy = [help?.id, error.id].filter(Boolean).join(' ');
			if (describedBy) {
				input.setAttribute('aria-describedby', describedBy);
			}
			if (ADVANCED_PATHS.has(issue.path)) {
				hasAdvancedIssue = true;
			}
		}
		if (hasAdvancedIssue) {
			advanced.open = true;
		}
		errorBanner.hidden = false;
		errorBanner.textContent =
			issues.length === 1
				? issues[0].message
				: `${issues.length} inputs need attention. Review the highlighted fields.`;
	}

	function markResultsInvalid(): void {
		resultsPanel.dataset.state = 'invalid';
		resultsPanel.setAttribute('aria-busy', 'false');
		resultsContent.classList.add('is-stale');
		copyButton.disabled = true;
		liveSummary.textContent = 'Results are paused because one or more inputs are invalid.';
	}

	function markResultsValid(): void {
		clearErrors();
		errorBanner.hidden = true;
		errorBanner.textContent = '';
		resultsPanel.dataset.state = 'valid';
		resultsPanel.setAttribute('aria-busy', 'false');
		resultsContent.classList.remove('is-stale');
		copyButton.disabled = false;
	}

	function niceStep(raw: number): number {
		const exponent = Math.floor(Math.log10(raw));
		const fraction = raw / 10 ** exponent;
		const niceFraction = fraction <= 1 ? 1 : fraction <= 2 ? 2 : fraction <= 5 ? 5 : 10;
		return niceFraction * 10 ** exponent;
	}

	function svgElement<K extends keyof SVGElementTagNameMap>(
		tag: K,
		attributes: Record<string, string | number>,
	): SVGElementTagNameMap[K] {
		const element = document.createElementNS(SVG_NS, tag);
		for (const [name, value] of Object.entries(attributes)) {
			element.setAttribute(name, String(value));
		}
		return element;
	}

	interface ChartElement {
		kind: 'interface' | 'layer' | 'back';
		index: number;
		label: string;
		resistance: number;
		type?: InterfaceType;
	}

	function chainElements(result: NetworkSnapshot): ChartElement[] {
		const elements: ChartElement[] = [];
		result.layers.forEach((layer, index) => {
			const networkInterface = result.interfaces[index];
			elements.push({
				kind: 'interface',
				index,
				label: `Connection ${index + 1} · ${INTERFACE_TYPE_LABELS[networkInterface.type]}`,
				resistance: networkInterface.resistance,
				type: networkInterface.type,
			});
			elements.push({
				kind: 'layer',
				index,
				label: `Node ${index + 2} · ${layer.label}`,
				resistance: layer.resistance,
			});
		});
		elements.push({
			kind: 'back',
			index: result.layers.length,
			label: 'Back surface',
			resistance: result.back.resistance,
		});
		return elements;
	}

	function elementClass(element: ChartElement): string {
		if (element.kind === 'back') {
			return 'is-back';
		}
		if (element.kind === 'layer') {
			return 'is-layer';
		}
		return `is-${element.type}`;
	}

	function renderChart(result: NetworkSnapshot): void {
		const nodes = result.temperatureNodes;
		const temperatures = nodes.map((node) => node.temperatureC);
		const left = 58;
		const right = 26;
		const top = 24;
		const plotWidth = 680 - left - right;
		const plotHeight = 320 - top - 76;
		const plotRight = left + plotWidth;
		const plotBottom = top + plotHeight;
		const xPositions = nodes.map(
			(_, index) => left + (plotWidth * index) / Math.max(nodes.length - 1, 1),
		);
		const minimum = Math.min(...temperatures);
		const maximum = Math.max(...temperatures);
		const range = Math.max(maximum - minimum, 1);
		const step = niceStep(range / 4);
		const axisMin = Math.floor((minimum - range * 0.05) / step) * step;
		const axisMax = Math.ceil((maximum + range * 0.05) / step) * step;
		const scaleY = (value: number): number =>
			plotBottom - ((value - axisMin) / (axisMax - axisMin)) * plotHeight;
		const tickDigits = step < 0.1 ? 2 : step < 1 ? 1 : 0;
		const tickFormatter = new Intl.NumberFormat('en-US', {
			maximumFractionDigits: tickDigits,
		});

		const grid = byId<SVGGElement>('chart-grid');
		const yAxis = byId<SVGGElement>('chart-y-axis');
		grid.replaceChildren();
		yAxis.replaceChildren();

		const tickCount = Math.min(Math.round((axisMax - axisMin) / step), 20);
		for (let index = 0; index <= tickCount; index += 1) {
			const value = axisMin + index * step;
			const y = scaleY(value);
			if (y < top - 1 || y > plotBottom + 1) {
				continue;
			}
			grid.append(
				svgElement('line', {
					x1: left,
					y1: y,
					x2: plotRight,
					y2: y,
					class: 'chart-grid-line',
				}),
			);
			const label = svgElement('text', {
				x: left - 10,
				y: y + 4,
				class: 'chart-tick-label',
				'text-anchor': 'end',
			});
			label.textContent = tickFormatter.format(value);
			yAxis.append(label);
		}

		const area = byId<SVGPolygonElement>('chart-area');
		area.setAttribute(
			'points',
			[
				`${left},${plotBottom}`,
				...xPositions.map((x, index) => `${x},${scaleY(temperatures[index])}`),
				`${plotRight},${plotBottom}`,
			].join(' '),
		);

		const segments = byId<SVGGElement>('chart-segments');
		segments.replaceChildren();
		const elements = chainElements(result);
		for (let index = 0; index < elements.length; index += 1) {
			segments.append(
				svgElement('line', {
					x1: xPositions[index],
					y1: scaleY(temperatures[index]),
					x2: xPositions[index + 1],
					y2: scaleY(temperatures[index + 1]),
					class: `chart-segment ${elementClass(elements[index])}`,
				}),
			);
		}

		const points = byId<SVGGElement>('chart-points');
		points.replaceChildren();
		const showAllLabels = nodes.length <= 8;
		nodes.forEach((node, index) => {
			const y = scaleY(node.temperatureC);
			const pointClass =
				node.kind === 'source'
					? 'point-hot'
					: node.kind === 'ambient'
						? 'point-cool'
						: 'point-layer';
			points.append(
				svgElement('circle', {
					cx: xPositions[index],
					cy: y,
					r: 4.5,
					class: `chart-point ${pointClass}`,
				}),
			);
			const isLayerBack = node.kind === 'layer-back';
			if (!showAllLabels && !(index === 0 || index === nodes.length - 1 || isLayerBack)) {
				return;
			}
			const label = svgElement('text', {
				x: xPositions[index],
				y: Math.max(top + 12, y - 12),
				class: 'chart-point-label',
				'text-anchor':
					index === 0 ? 'start' : index === nodes.length - 1 ? 'end' : 'middle',
			});
			label.textContent = `${fixedOne.format(node.temperatureC)} °C`;
			points.append(label);
		});

		const xAxis = byId<SVGGElement>('chart-x-axis');
		xAxis.replaceChildren();
		if (showAllLabels) {
			nodes.forEach((node, index) => {
				const label = svgElement('text', {
					x: xPositions[index],
					y: 274,
					class: 'chart-x-label',
					'text-anchor': 'middle',
				});
				label.textContent = node.shortLabel;
				xAxis.append(label);
			});
		} else {
			const sourceLabel = svgElement('text', {
				x: xPositions[0],
				y: 274,
				class: 'chart-x-label',
				'text-anchor': 'start',
			});
			sourceLabel.textContent = 'Source';
			xAxis.append(sourceLabel);

			result.layers.forEach((_layer, index) => {
				const backNodeIndex = 2 + index * 2;
				const label = svgElement('text', {
					x: xPositions[backNodeIndex],
					y: 274,
					class: 'chart-x-label',
					'text-anchor': 'middle',
				});
				label.textContent = `L${index + 1}`;
				xAxis.append(label);
			});

			const ambientLabel = svgElement('text', {
				x: xPositions[nodes.length - 1],
				y: 274,
				class: 'chart-x-label',
				'text-anchor': 'end',
			});
			ambientLabel.textContent = 'Ambient';
			xAxis.append(ambientLabel);
		}

		const description = nodes
			.map((node) => `${node.shortLabel} ${fixedOne.format(node.temperatureC)} degrees Celsius`)
			.join(', ');
		const chartDescription = document.getElementById('chart-desc');
		if (chartDescription) {
			chartDescription.textContent = `Surface temperature profile: ${description}.`;
		}
	}

	function statusHtml(result: ThermalNetworkResult): string {
		const badgeClass = result.converged ? 'is-success' : 'is-warning';
		const badgeText = result.converged
			? `Converged in ${result.iterations} iterations · residual ${formatResidual(result.errorK)} K`
			: `Iteration limit reached after ${result.iterations} iterations · results may be approximate`;
		const airFitWarning = result.airFitOutOfRange
			? '<span class="status-note is-warning">One or more gap mean temperatures are outside the 300–900 K air-fit range.</span>'
			: '';
		return `<div class="status-row">
			<span class="status-badge ${badgeClass}">${escapeHtml(badgeText)}</span>
			${airFitWarning}
		</div>`;
	}

	function heroHtml(result: ThermalNetworkResult): string {
		const hasDissipation = result.totalDissipationWm2 > 0;
		const label = hasDissipation ? 'Source-side heat flux' : 'Heat flux';
		const secondary = hasDissipation
			? `${fixedThree.format(result.heatFluxWm2 / 1000)} kW/m² · ambient side ${formatFlux(result.ambientHeatFluxWm2)} W/m² · removed ${formatFlux(result.totalDissipationWm2)} W/m²`
			: `${fixedThree.format(result.heatFluxWm2 / 1000)} kW/m²`;
		return `<div class="result-hero">
			<div class="hero-heading">
				<p class="result-label">${label} <span class="symbol">q″</span></p>
				<span class="hero-unit">per unit area</span>
			</div>
			<p class="hero-value">
				<span>${formatFlux(result.heatFluxWm2)}</span>
				<span class="hero-metric">W/m²</span>
			</p>
			<p class="hero-secondary">${secondary}</p>
			<div class="hero-meta">
				<span>Total R″ <strong>${formatResistance(result.totalResistance)}</strong> m²·K/W</span>
				<span>Layers <strong>${result.layers.length}</strong></span>
			</div>
		</div>`;
	}

	function nodeTemperaturesHtml(snapshot: NetworkSnapshot, initialTemperatureC?: number): string {
		const cards: string[] = [];
		const hasInitial = initialTemperatureC !== undefined;
		cards.push(`<div class="temp-node is-source">
			<div class="temp-node-top">
				<span class="temp-node-name">Node 1 · Heat source</span>
				<span class="temp-node-kind">Boundary</span>
			</div>
			<div class="temp-node-single"><strong>${formatTemperature(snapshot.sourceTemperatureC)}</strong><span>°C</span></div>
		</div>`);

		snapshot.layers.forEach((layer, index) => {
			const initialNote = hasInitial
				? `<p class="temp-node-extra">Initial ${formatTemperature(initialTemperatureC ?? 0)} °C · final mean ${formatTemperature(layer.meanTemperatureC)} °C</p>`
				: '';
			cards.push(`<div class="temp-node is-layer">
				<div class="temp-node-top">
					<span class="temp-node-name">Node ${index + 2} · ${escapeHtml(layer.label)}</span>
					<span class="temp-node-kind">${formatLength(layer.thicknessM * 1000)} mm</span>
				</div>
				<div class="temp-node-pair">
					<span><small>Front</small><strong>${formatTemperature(layer.frontTemperatureC)}</strong><em>°C</em></span>
					<span class="temp-node-arrow" aria-hidden="true">→</span>
					<span><small>Back</small><strong>${formatTemperature(layer.backTemperatureC)}</strong><em>°C</em></span>
				</div>
				${initialNote}
			</div>`);
		});

		cards.push(`<div class="temp-node is-ambient">
			<div class="temp-node-top">
				<span class="temp-node-name">Node ${snapshot.layers.length + 2} · Ambient</span>
				<span class="temp-node-kind">Boundary</span>
			</div>
			<div class="temp-node-single"><strong>${formatTemperature(snapshot.ambientTemperatureC)}</strong><span>°C</span></div>
		</div>`);

		return `<section class="node-temperatures" aria-labelledby="node-temperatures-title">
			<div class="section-heading">
				<h3 id="node-temperatures-title">${hasInitial ? 'Final node temperatures' : 'Node temperatures'}</h3>
				<span>°C</span>
			</div>
			<div class="temp-chain">${cards.join('')}</div>
		</section>`;
	}

	function chartCardHtml(result: NetworkSnapshot): string {
		const elements = chainElements(result);
		const total = result.totalResistance;
		const barSegments = elements
			.map((element) => {
				const share = total > 0 ? element.resistance / total : 0;
				return `<span
					class="bar-segment ${elementClass(element)}"
					style="width:${(share * 100).toFixed(3)}%"
					title="${escapeHtml(element.label)} · ${formatPercent(share)}"
				></span>`;
			})
			.join('');
		return `<figure class="chart-card">
			<figcaption class="chart-heading">
				<div>
					<h3>Surface temperature profile</h3>
					<p>${result.layers.length} material ${result.layers.length === 1 ? 'layer' : 'layers'} in series</p>
				</div>
				<span class="chart-unit">°C</span>
			</figcaption>
			<div class="resistance-bar" aria-hidden="true">${barSegments}</div>
			<p class="bar-caption">Widths show each element's share of total resistance.</p>
			<svg
				id="temp-chart"
				viewBox="0 0 680 320"
				role="img"
				aria-labelledby="chart-title chart-desc"
			>
				<title id="chart-title">Surface temperature profile through the thermal network</title>
				<desc id="chart-desc">Surface temperature profile.</desc>
				<g id="chart-grid"></g>
				<polygon id="chart-area" points=""></polygon>
				<g id="chart-segments"></g>
				<g id="chart-points"></g>
				<g id="chart-y-axis"></g>
				<g id="chart-x-axis"></g>
			</svg>
			<div class="chart-legend">
				<span><i class="dot is-air-gap"></i>Air gap</span>
				<span><i class="dot is-layer"></i>Material</span>
				<span><i class="dot is-adhesive"></i>Adhesive</span>
				<span><i class="dot is-bonded"></i>Bonded/contact</span>
				<span><i class="dot is-back"></i>Back boundary</span>
			</div>
			<p class="chart-note">Nodes are evenly spaced for readability. Segment colours match the table.</p>
		</figure>`;
	}

	function subRowHtml(label: string, resistance: number): string {
		return `<tr class="sub-row">
			<td class="sub-label">↳ ${escapeHtml(label)} <span class="parallel-tag">parallel</span></td>
			<td>${formatResistance(resistance)}</td>
			<td>—</td>
			<td>—</td>
		</tr>`;
	}

	function interfaceRowHtml(result: NetworkSnapshot, index: number): string {
		const networkInterface = result.interfaces[index];
		const total = result.totalResistance;
		const share = total > 0 ? networkInterface.resistance / total : 0;
		let note = '';
		if (networkInterface.type === 'air-gap') {
			const convectionFactor = networkInterface.gapConvectionFactor ?? 1;
			const factorNote =
				Math.abs(convectionFactor - 1) > 1e-9
					? ` · convection ×${formatProperty(convectionFactor)}`
					: '';
			const dissipation = networkInterface.dissipationWm2 ?? 0;
			const dissipationNote =
				dissipation > 0 ? ` · air-flow loss ${formatFlux(dissipation)} W/m²` : '';
			note = `ε<sub>eff</sub> ${formatEmissivity(networkInterface.effectiveEmissivity ?? Number.NaN)} · k<sub>air</sub> ${formatProperty(networkInterface.airConductivityWmK ?? Number.NaN)} W/(m·K) · ${formatLength((networkInterface.gapThicknessM ?? 0) * 1000)} mm${factorNote}${dissipationNote}`;
		} else if (networkInterface.type === 'bonded') {
			note = 'Perfect contact · zero resistance';
		} else if (networkInterface.type === 'adhesive') {
			note = `${formatLength((networkInterface.adhesiveThicknessM ?? 0) * 1000)} mm · k ${formatProperty(networkInterface.adhesiveConductivityWmK ?? Number.NaN)} W/(m·K)`;
		} else {
			note = 'Specified areal contact resistance';
		}

		let subRows = '';
		if (networkInterface.type === 'air-gap') {
			subRows += subRowHtml('Conduction', networkInterface.conductionResistance ?? 0);
			subRows += subRowHtml('Radiation', networkInterface.radiationResistance ?? 0);
		}

		return `<tr class="element-row">
			<th scope="row" class="element-cell">
				<span class="element-name"><i class="dot ${elementClass({ kind: 'interface', index, label: '', resistance: 0, type: networkInterface.type })}"></i>Connection ${index + 1} · ${escapeHtml(INTERFACE_TYPE_LABELS[networkInterface.type])}</span>
				<span class="row-note">${note}</span>
			</th>
			<td>${formatResistance(networkInterface.resistance)}</td>
			<td>${formatPercent(share)}</td>
			<td>${formatDelta(networkInterface.temperatureDropK)}</td>
		</tr>${subRows}`;
	}

	function layerRowHtml(result: NetworkSnapshot, index: number): string {
		const layer = result.layers[index];
		const total = result.totalResistance;
		const share = total > 0 ? layer.resistance / total : 0;
		const note = `${formatLength(layer.thicknessM * 1000)} mm · k ${formatProperty(layer.conductivityWmK)} W/(m·K) · ε ${formatEmissivity(layer.frontEmissivity)} front / ${formatEmissivity(layer.backEmissivity)} back`;
		return `<tr class="element-row">
			<th scope="row" class="element-cell">
				<span class="element-name"><i class="dot is-layer"></i>Node ${index + 2} · ${escapeHtml(layer.label)}</span>
				<span class="row-note">${note}</span>
			</th>
			<td>${formatResistance(layer.resistance)}</td>
			<td>${formatPercent(share)}</td>
			<td>${formatDelta(layer.temperatureDropK)}</td>
		</tr>`;
	}

	function backRowHtml(result: NetworkSnapshot): string {
		const total = result.totalResistance;
		const share = total > 0 ? result.back.resistance / total : 0;
		const note = `h<sub>conv</sub> ${formatProperty(1 / result.back.convectionResistance)} W/(m²·K) · ε ${formatEmissivity(result.back.effectiveEmissivity)}`;
		return `<tr class="element-row">
			<th scope="row" class="element-cell">
				<span class="element-name"><i class="dot is-back"></i>Back surface · Ambient</span>
				<span class="row-note">${note}</span>
			</th>
			<td>${formatResistance(result.back.resistance)}</td>
			<td>${formatPercent(share)}</td>
			<td>${formatDelta(result.back.temperatureDropK)}</td>
		</tr>
		${subRowHtml('Convection', result.back.convectionResistance)}
		${subRowHtml('Radiation', result.back.radiationResistance)}`;
	}

	function breakdownHtml(
		snapshot: NetworkSnapshot,
		options: { title?: string; transient?: boolean } = {},
	): string {
		const rows: string[] = [];
		snapshot.layers.forEach((_layer, index) => {
			rows.push(interfaceRowHtml(snapshot, index));
			rows.push(layerRowHtml(snapshot, index));
		});
		rows.push(backRowHtml(snapshot));
		const totalDrop = snapshot.sourceTemperatureC - snapshot.ambientTemperatureC;
		const transientNote = options.transient
			? ' ΔT values are instantaneous surface differences at the final time; heat flux is not uniform during the transient.'
			: '';
		return `<section class="breakdown" aria-labelledby="breakdown-title">
			<div class="section-heading">
				<h3 id="breakdown-title">${options.title ?? 'Resistance breakdown'}</h3>
				<span>R″ in m²·K/W</span>
			</div>
			<div class="table-wrap">
				<table>
					<caption class="sr-only">Thermal resistances, their share of the total and temperature drops.</caption>
					<thead>
						<tr>
							<th scope="col">Element</th>
							<th scope="col">R″</th>
							<th scope="col">Share</th>
							<th scope="col">ΔT</th>
						</tr>
					</thead>
					<tbody>
						${rows.join('')}
						<tr class="total-row">
							<th scope="row">Total</th>
							<td>${formatResistance(snapshot.totalResistance)}</td>
							<td>100.0%</td>
							<td>${formatDelta(totalDrop)}</td>
						</tr>
					</tbody>
				</table>
			</div>
			<p class="table-note">Parallel components are shown for reference; their equivalent resistance is the value used in the series network.${transientNote}</p>
		</section>`;
	}

	function renderResults(result: ThermalNetworkResult): void {
		resultsDynamic.innerHTML = `${heroHtml(result)}
			${statusHtml(result)}
			${nodeTemperaturesHtml(result)}
			${chartCardHtml(result)}
			${breakdownHtml(result)}`;
		renderChart(result);
		const layerSummary = result.layers
			.map(
				(layer, index) =>
					`Node ${index + 2} ${layer.label} ${formatTemperature(layer.frontTemperatureC)} to ${formatTemperature(layer.backTemperatureC)} degrees Celsius`,
			)
			.join('. ');
		const fluxSummary =
			result.totalDissipationWm2 > 0
				? `Source-side heat flux ${formatFlux(result.heatFluxWm2)} watts per square metre, ambient side ${formatFlux(result.ambientHeatFluxWm2)} watts per square metre, with ${formatFlux(result.totalDissipationWm2)} watts per square metre removed by air flow in the gaps.`
				: `Heat flux ${formatFlux(result.heatFluxWm2)} watts per square metre.`;
		liveSummary.textContent = `${fluxSummary} ${layerSummary}. ${result.converged ? `Converged in ${result.iterations} iterations.` : 'The solver did not converge.'}`;
	}

	function seriesClass(index: number): string {
		return `series-${index % 8}`;
	}

	function transientHeroHtml(result: TransientNetworkResult): string {
		const finalStep = result.steps[result.steps.length - 1];
		const sourceFlux =
			finalStep.sourceHeatFluxWm2 !== null
				? ` · source-side ${formatFlux(finalStep.sourceHeatFluxWm2)} W/m²`
				: '';
		return `<div class="result-hero">
			<div class="hero-heading">
				<p class="result-label">Ambient-side heat flux</p>
				<span class="hero-unit">at t = ${formatTime(result.settings.finalTimeS)} s</span>
			</div>
			<p class="hero-value">
				<span>${formatFlux(finalStep.ambientHeatFluxWm2)}</span>
				<span class="hero-metric">W/m²</span>
			</p>
			<p class="hero-secondary">${fixedThree.format(finalStep.ambientHeatFluxWm2 / 1000)} kW/m²${sourceFlux}</p>
			<div class="hero-meta">
				<span>Δt <strong>${formatTime(result.settings.timeStepS)} s</strong></span>
				<span>Steps <strong>${result.steps.length - 1}</strong></span>
				<span>Final R″ <strong>${formatResistance(result.final.totalResistance)}</strong> m²·K/W</span>
			</div>
		</div>`;
	}

	function transientStatusHtml(result: TransientNetworkResult): string {
		const warning = result.final.airFitOutOfRange
			? '<span class="status-note is-warning">One or more gap mean temperatures are outside the 300–900 K air-fit range.</span>'
			: '';
		return `<div class="status-row">
			<span class="status-badge is-success">Completed ${result.steps.length - 1} steps · t = ${formatTime(result.settings.finalTimeS)} s · backward Euler</span>
			<span class="status-note">Heat flux can vary along the stack due to thermal storage and air-gap removal.</span>
			${warning}
		</div>`;
	}

	function transientChartCardHtml(result: TransientNetworkResult): string {
		const legend = result.final.layers
			.map(
				(layer, index) =>
					`<span><i class="series-dot ${seriesClass(index)}"></i>${escapeHtml(layer.label)} <strong>${formatTemperature(layer.meanTemperatureC)} °C</strong></span>`,
			)
			.join('');
		return `<figure class="chart-card">
			<figcaption class="chart-heading">
				<div>
					<h3>Temperature history</h3>
					<p>Layer mean temperatures from t = 0 to ${formatTime(result.settings.finalTimeS)} s</p>
				</div>
				<span class="chart-unit">°C</span>
			</figcaption>
			<svg
				id="transient-chart"
				viewBox="0 0 680 340"
				role="img"
				aria-labelledby="transient-chart-title transient-chart-desc"
			>
				<title id="transient-chart-title">Layer temperature history</title>
				<desc id="transient-chart-desc">Temperature history.</desc>
				<g id="transient-y-grid"></g>
				<g id="transient-x-grid"></g>
				<g id="transient-lines"></g>
				<g id="transient-points"></g>
				<g id="transient-y-axis"></g>
				<g id="transient-x-axis"></g>
			</svg>
			<div class="chart-legend">${legend}</div>
			<p class="chart-note">
				Source held at ${formatTemperature(result.final.sourceTemperatureC)} °C; ambient at
				${formatTemperature(result.final.ambientTemperatureC)} °C. Each point is an output step.
			</p>
		</figure>`;
	}

	function transientHistoryHtml(result: TransientNetworkResult): string {
		const headers = result.final.layers
			.map(
				(layer, index) =>
					`<th scope="col">Node ${index + 2} · ${escapeHtml(layer.label)}</th>`,
			)
			.join('');
		const rows = result.steps
			.map(
				(step) => `<tr>
					<th scope="row">${formatTime(step.timeS)}</th>
					${step.layerMeanTemperaturesC.map((temperature) => `<td>${formatTemperature(temperature)}</td>`).join('')}
					<td>${formatFlux(step.ambientHeatFluxWm2)}</td>
				</tr>`,
			)
			.join('');
		return `<details class="time-history">
			<summary>Time history <span>${result.steps.length} samples</span></summary>
			<div class="table-wrap">
				<table>
					<caption class="sr-only">Layer mean temperatures and ambient heat flux at each output time.</caption>
					<thead>
						<tr>
							<th scope="col">Time (s)</th>
							${headers}
							<th scope="col">q″ out (W/m²)</th>
						</tr>
					</thead>
					<tbody>${rows}</tbody>
				</table>
			</div>
		</details>`;
	}

	function renderTransientChart(result: TransientNetworkResult): void {
		const left = 58;
		const right = 26;
		const top = 24;
		const plotWidth = 680 - left - right;
		const plotHeight = 340 - top - 76;
		const plotRight = left + plotWidth;
		const plotBottom = top + plotHeight;
		const finalTime = Math.max(result.settings.finalTimeS, 1e-9);
		const allTemperatures = result.steps.flatMap((step) => step.layerMeanTemperaturesC);
		const minimum = Math.min(...allTemperatures);
		const maximum = Math.max(...allTemperatures);
		const temperatureRange = Math.max(maximum - minimum, 1);
		const temperatureStep = niceStep(temperatureRange / 4);
		const axisMin = Math.floor((minimum - temperatureRange * 0.05) / temperatureStep) * temperatureStep;
		const axisMax = Math.ceil((maximum + temperatureRange * 0.05) / temperatureStep) * temperatureStep;
		const scaleY = (value: number): number =>
			plotBottom - ((value - axisMin) / (axisMax - axisMin)) * plotHeight;
		const scaleX = (value: number): number => left + (value / finalTime) * plotWidth;
		const temperatureFormatter = new Intl.NumberFormat('en-US', {
			maximumFractionDigits: temperatureStep < 1 ? 1 : 0,
		});

		const yGrid = byId<SVGGElement>('transient-y-grid');
		const xGrid = byId<SVGGElement>('transient-x-grid');
		const yAxis = byId<SVGGElement>('transient-y-axis');
		const xAxis = byId<SVGGElement>('transient-x-axis');
		yGrid.replaceChildren();
		xGrid.replaceChildren();
		yAxis.replaceChildren();
		xAxis.replaceChildren();

		const yTickCount = Math.min(
			Math.round((axisMax - axisMin) / temperatureStep),
			20,
		);
		for (let index = 0; index <= yTickCount; index += 1) {
			const value = axisMin + index * temperatureStep;
			const y = scaleY(value);
			if (y < top - 1 || y > plotBottom + 1) {
				continue;
			}
			yGrid.append(
				svgElement('line', {
					x1: left,
					y1: y,
					x2: plotRight,
					y2: y,
					class: 'chart-grid-line',
				}),
			);
			const label = svgElement('text', {
				x: left - 10,
				y: y + 4,
				class: 'chart-tick-label',
				'text-anchor': 'end',
			});
			label.textContent = temperatureFormatter.format(value);
			yAxis.append(label);
		}

		const timeStep = niceStep(finalTime / 6);
		const timeTicks: number[] = [0];
		for (let value = timeStep; value < finalTime - 1e-9; value += timeStep) {
			timeTicks.push(value);
		}
		timeTicks.push(finalTime);
		for (const value of timeTicks) {
			const x = scaleX(value);
			xGrid.append(
				svgElement('line', {
					x1: x,
					y1: top,
					x2: x,
					y2: plotBottom,
					class: 'chart-grid-line',
				}),
			);
			const label = svgElement('text', {
				x,
				y: plotBottom + 18,
				class: 'chart-x-label',
				'text-anchor': 'middle',
			});
			label.textContent = formatTime(value);
			xAxis.append(label);
		}

		const axisTitle = svgElement('text', {
			x: left + plotWidth / 2,
			y: plotBottom + 42,
			class: 'chart-axis-title',
			'text-anchor': 'middle',
		});
		axisTitle.textContent = 'Time (s)';
		xAxis.append(axisTitle);

		const lines = byId<SVGGElement>('transient-lines');
		const points = byId<SVGGElement>('transient-points');
		lines.replaceChildren();
		points.replaceChildren();
		const showPoints = result.steps.length <= 31;
		result.final.layers.forEach((_layer, layerIndex) => {
			const line = svgElement('polyline', {
				points: result.steps
					.map(
						(step) =>
							`${scaleX(step.timeS)},${scaleY(step.layerMeanTemperaturesC[layerIndex])}`,
					)
					.join(' '),
				class: `chart-series-line ${seriesClass(layerIndex)}`,
			});
			lines.append(line);
			if (showPoints) {
				for (const step of result.steps) {
					points.append(
						svgElement('circle', {
							cx: scaleX(step.timeS),
							cy: scaleY(step.layerMeanTemperaturesC[layerIndex]),
							r: 2.6,
							class: `chart-series-dot ${seriesClass(layerIndex)}`,
						}),
					);
				}
			}
		});

		const finalStep = result.steps[result.steps.length - 1];
		const finalSummary = result.final.layers
			.map(
				(layer, index) =>
					`${layer.label} final mean ${formatTemperature(finalStep.layerMeanTemperaturesC[index])} degrees Celsius`,
			)
			.join(', ');
		const chartDescription = document.getElementById('transient-chart-desc');
		if (chartDescription) {
			chartDescription.textContent = `Temperature history from 0 to ${formatTime(finalTime)} seconds. ${finalSummary}.`;
		}
	}

	function renderTransientResults(result: TransientNetworkResult): void {
		resultsDynamic.innerHTML = `${transientHeroHtml(result)}
			${transientStatusHtml(result)}
			${nodeTemperaturesHtml(result.final, result.settings.initialTemperatureC)}
			${transientChartCardHtml(result)}
			${transientHistoryHtml(result)}
			${breakdownHtml(result.final, {
				title: `Resistance breakdown at t = ${formatTime(result.settings.finalTimeS)} s`,
				transient: true,
			})}`;
		renderTransientChart(result);
		const finalStep = result.steps[result.steps.length - 1];
		const layerSummary = result.final.layers
			.map(
				(layer, index) =>
					`Node ${index + 2} ${layer.label} final mean ${formatTemperature(finalStep.layerMeanTemperaturesC[index])} degrees Celsius`,
			)
			.join('. ');
		liveSummary.textContent = `Transient run to ${formatTime(result.settings.finalTimeS)} seconds. ${layerSummary}. Ambient heat flux ${formatFlux(finalStep.ambientHeatFluxWm2)} watts per square metre.`;
	}

	function refresh(options: { rerenderChain?: boolean; focus?: () => void } = {}): void {
		if (options.rerenderChain) {
			renderChain();
		}
		updateModelControls();
		updateComputedHints();
		const issues = validateNetworkState(state);
		if (issues.length > 0) {
			showErrors(issues);
			markResultsInvalid();
			options.focus?.();
			return;
		}

		clearErrors();
		try {
			const inputs = buildNetworkInputs(state);
			if (state.modelMode === 'transient') {
				const result = solveTransientNetwork(inputs, {
					timeStepS: state.timeStepS,
					finalTimeS: state.finalTimeS,
					initialTemperatureC: state.initialTemperatureC,
				});
				lastRun = { mode: 'transient', result, inputs };
				markResultsValid();
				renderTransientResults(result);
			} else {
				const result = solveThermalNetwork(inputs);
				lastRun = { mode: 'steady', result, inputs };
				markResultsValid();
				renderResults(result);
			}
		} catch (error) {
			lastRun = null;
			clearErrors();
			errorBanner.hidden = false;
			errorBanner.textContent =
				error instanceof Error ? error.message : 'Unable to solve the thermal network.';
			markResultsInvalid();
		}
		options.focus?.();
	}

	function scheduleRefresh(): void {
		copyButton.disabled = true;
		if (scheduledFrame) {
			cancelAnimationFrame(scheduledFrame);
		}
		scheduledFrame = requestAnimationFrame(() => {
			scheduledFrame = 0;
			refresh();
		});
	}

	function readFieldValue(element: HTMLInputElement | HTMLSelectElement): string | number {
		if (element instanceof HTMLInputElement && element.type === 'number') {
			const raw = element.value.trim();
			return raw === '' ? Number.NaN : Number(element.value);
		}
		return element.value;
	}

	function handleFieldInput(event: Event): void {
		const target = event.target;
		if (!(target instanceof HTMLInputElement)) {
			return;
		}
		const path = target.dataset.path;
		if (!path) {
			return;
		}
		setValueAtPath(state, path, readFieldValue(target));
		if (!ADVANCED_PATHS.has(path) && !SIMULATION_PATHS.has(path)) {
			markCustomNetwork();
		}
		scheduleRefresh();
	}

	function handleFieldChange(event: Event): void {
		const target = event.target;
		if (!(target instanceof HTMLSelectElement)) {
			return;
		}
		const path = target.dataset.path;
		if (!path) {
			return;
		}
		const value = target.value;

		if (path.endsWith('.materialId')) {
			const index = layerIndexFromMaterialPath(path);
			if (index !== null && state.layers[index]) {
				state.layers[index] = applyMaterialToLayer(state.layers[index], value);
			}
			markCustomNetwork();
			refresh({
				rerenderChain: true,
				focus: () => findByPath(path)?.focus(),
			});
			return;
		}

		setValueAtPath(state, path, value);
		if (!ADVANCED_PATHS.has(path)) {
			markCustomNetwork();
		}
		if (target.dataset.rerender === 'chain') {
			refresh({
				rerenderChain: true,
				focus: () => findByPath(path)?.focus(),
			});
		} else {
			scheduleRefresh();
		}
	}

	function handleAction(event: Event): void {
		const target = event.target;
		if (!(target instanceof Element)) {
			return;
		}
		const button = target.closest<HTMLButtonElement>('button[data-action]');
		if (!button || !chainContainer.contains(button)) {
			return;
		}
		const action = button.dataset.action;
		const index = Number(button.dataset.index ?? '-1');

		if (action === 'add-layer') {
			if (state.layers.length >= MAX_LAYERS) {
				return;
			}
			const newLayer = createLayer('custom', { label: 'New layer' });
			state.layers.push(newLayer);
			state.interfaces.push(createInterface('bonded'));
			markCustomNetwork();
			const focusIndex = state.layers.length - 1;
			refresh({
				rerenderChain: true,
				focus: () => document.getElementById(`layer-${focusIndex}-label`)?.focus(),
			});
			return;
		}

		if (action === 'remove-layer') {
			if (state.layers.length <= 1 || index < 0 || index >= state.layers.length) {
				return;
			}
			state.layers.splice(index, 1);
			state.interfaces.splice(index, 1);
			markCustomNetwork();
			const focusIndex = Math.max(0, Math.min(index, state.layers.length - 1));
			refresh({
				rerenderChain: true,
				focus: () => document.getElementById(`layer-${focusIndex}-label`)?.focus(),
			});
			return;
		}

		if (action === 'move-up' && index > 0) {
			[state.layers[index - 1], state.layers[index]] = [
				state.layers[index],
				state.layers[index - 1],
			];
			markCustomNetwork();
			refresh({
				rerenderChain: true,
				focus: () => document.getElementById(`layer-${index - 1}-label`)?.focus(),
			});
			return;
		}

		if (action === 'move-down' && index >= 0 && index < state.layers.length - 1) {
			[state.layers[index + 1], state.layers[index]] = [
				state.layers[index],
				state.layers[index + 1],
			];
			markCustomNetwork();
			refresh({
				rerenderChain: true,
				focus: () => document.getElementById(`layer-${index + 1}-label`)?.focus(),
			});
		}
	}

	function syncAdvancedInputs(): void {
		const values: Record<string, number> = {
			foilEmissivity: state.foilEmissivity,
			airFitIntercept: state.airFitIntercept,
			airFitSlope: state.airFitSlope,
			gapConvectionFactor: state.gapConvectionFactor,
			toleranceK: state.toleranceK,
			maxIterations: state.maxIterations,
			relaxation: state.relaxation,
		};
		for (const [id, value] of Object.entries(values)) {
			const input = document.getElementById(id) as HTMLInputElement | null;
			if (input) {
				input.value = numberInputValue(value);
			}
		}
	}

	function syncTransientInputs(): void {
		const values: Record<string, number> = {
			timeStepS: state.timeStepS,
			finalTimeS: state.finalTimeS,
			initialTemperatureC: state.initialTemperatureC,
		};
		for (const [id, value] of Object.entries(values)) {
			const input = document.getElementById(id) as HTMLInputElement | null;
			if (input) {
				input.value = numberInputValue(value);
			}
		}
	}

	function summaryHeader(mode: 'steady' | 'transient'): string[] {
		const template = getTemplate(state.templateId);
		return [
			'1D Thermal Network Model',
			`Template: ${template ? template.name : 'Custom network'}`,
			`Mode: ${mode === 'steady' ? 'Steady state' : 'Transient'}`,
			`Air-gap convection factor: ${formatProperty(state.gapConvectionFactor)}`,
		];
	}

	function summaryNetworkLines(snapshot: NetworkSnapshot): string[] {
		return [
			`T_hot: ${formatTemperature(snapshot.sourceTemperatureC)} °C`,
			`T_inf: ${formatTemperature(snapshot.ambientTemperatureC)} °C`,
			'',
			'Layers:',
			...snapshot.layers.map(
				(layer, index) =>
					`Node ${index + 2} · ${layer.label}: front ${formatTemperature(layer.frontTemperatureC)} °C, back ${formatTemperature(layer.backTemperatureC)} °C, ${formatLength(layer.thicknessM * 1000)} mm, k ${formatProperty(layer.conductivityWmK)} W/(m·K), ε front ${formatEmissivity(layer.frontEmissivity)} / back ${formatEmissivity(layer.backEmissivity)}`,
			),
			'',
			'Connections:',
			...snapshot.interfaces.map((networkInterface, index) => {
				const dissipation = networkInterface.dissipationWm2 ?? 0;
				const dissipationNote =
					dissipation > 0
						? `, air-flow loss ${formatFlux(dissipation)} W/m²`
						: '';
				return `Connection ${index + 1} · ${INTERFACE_TYPE_LABELS[networkInterface.type]}: R ${formatResistance(networkInterface.resistance)} m²·K/W, ΔT ${formatDelta(networkInterface.temperatureDropK)}${dissipationNote}`;
			}),
			`Back surface: R ${formatResistance(snapshot.back.resistance)} m²·K/W, ΔT ${formatDelta(snapshot.back.temperatureDropK)}`,
			`Total resistance: ${formatResistance(snapshot.totalResistance)} m²·K/W`,
		];
	}

	function buildSteadySummary(result: ThermalNetworkResult): string {
		return [
			...summaryHeader('steady'),
			...summaryNetworkLines(result),
			'',
			`Source-side heat flux: ${formatFlux(result.heatFluxWm2)} W/m²`,
			`Ambient-side heat flux: ${formatFlux(result.ambientHeatFluxWm2)} W/m²`,
			`Air-flow removal: ${formatFlux(result.totalDissipationWm2)} W/m²`,
			result.converged
				? `Solver: converged in ${result.iterations} iterations`
				: `Solver: stopped after ${result.iterations} iterations without converging`,
		].join('\n');
	}

	function buildTransientSummary(result: TransientNetworkResult): string {
		const finalStep = result.steps[result.steps.length - 1];
		const layerMassLines = result.final.layers.map((layer, index) => {
			const layerState = state.layers[index];
			const capacity = layerState
				? layerState.densityKgM3 * layerState.specificHeatJkgK * layer.thicknessM
				: Number.NaN;
			return `Node ${index + 2} · ${layer.label}: C″ ${formatProperty(capacity)} J/(m²·K)`;
		});
		const historyLines = result.steps.map(
			(step) =>
				`  t = ${formatTime(step.timeS)} s: ${step.layerMeanTemperaturesC.map((temperature) => `${formatTemperature(temperature)} °C`).join(' / ')}; q″ out ${formatFlux(step.ambientHeatFluxWm2)} W/m²`,
		);
		return [
			...summaryHeader('transient'),
			`Initial temperature: ${formatTemperature(result.settings.initialTemperatureC)} °C`,
			`Time step: ${formatTime(result.settings.timeStepS)} s`,
			`Final time: ${formatTime(result.settings.finalTimeS)} s`,
			...summaryNetworkLines(result.final),
			'',
			'Thermal mass:',
			...layerMassLines,
			'',
			`Final ambient heat flux: ${formatFlux(finalStep.ambientHeatFluxWm2)} W/m²`,
			finalStep.sourceHeatFluxWm2 !== null
				? `Final source-side heat flux: ${formatFlux(finalStep.sourceHeatFluxWm2)} W/m²`
				: 'Final source-side heat flux: not available for a zero-resistance first connection',
			'',
			'Time history:',
			...historyLines,
		].join('\n');
	}

	async function copyText(text: string): Promise<void> {
		if (!navigator.clipboard?.writeText) {
			throw new Error('Clipboard API unavailable');
		}
		await navigator.clipboard.writeText(text);
	}

	function showCopyState(label: string): void {
		copyButton.textContent = label;
		window.clearTimeout(copyTimer);
		copyTimer = window.setTimeout(() => {
			copyButton.textContent = 'Copy results';
		}, 1600);
	}

	copyButton.addEventListener('click', async () => {
		if (!lastRun || lastRun.mode !== state.modelMode) {
			return;
		}
		try {
			const summary =
				lastRun.mode === 'steady'
					? buildSteadySummary(lastRun.result)
					: buildTransientSummary(lastRun.result);
			await copyText(summary);
			showCopyState('Copied');
		} catch {
			showCopyState('Copy failed');
		}
	});

	resetButton.addEventListener('click', () => {
		state = createInitialState(DEFAULT_TEMPLATE_ID);
		templateSelect.value = state.templateId;
		syncAdvancedInputs();
		syncTransientInputs();
		advanced.open = false;
		updateTemplateDescription();
		updateModelControls();
		refresh({ rerenderChain: true, focus: () => resetButton.focus() });
	});

	templateSelect.addEventListener('change', () => {
		const selected = templateSelect.value;
		if (selected === 'custom') {
			state.templateId = 'custom';
			updateTemplateDescription();
			return;
		}
		const template = getTemplate(selected);
		if (!template) {
			return;
		}
		state = applyTemplate(state, template);
		updateTemplateDescription();
		refresh({ rerenderChain: true });
	});

	modelButtons.forEach((button) => {
		button.addEventListener('click', () => {
			const mode = button.dataset.modelMode;
			if (mode !== 'steady' && mode !== 'transient') {
				return;
			}
			if (state.modelMode === mode) {
				return;
			}
			state.modelMode = mode as ModelMode;
			refresh({ rerenderChain: true });
		});
	});

	form.addEventListener('input', handleFieldInput);
	form.addEventListener('change', handleFieldChange);
	form.addEventListener('submit', (event) => {
		event.preventDefault();
		refresh();
	});
	chainContainer.addEventListener('click', handleAction);

	templateSelect.value = state.templateId;
	syncAdvancedInputs();
	syncTransientInputs();
	updateTemplateDescription();
	updateModelControls();
	renderChain();
	refresh();
</script>

