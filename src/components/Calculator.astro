		path: string;
		label: string;
		surface: SurfaceState;
		bareEmissivity: number;
		computedPrefix: string;
		faceNote: string;
	}): string {
		const effective = resolveSurfaceEmissivity(
			options.surface,
			options.bareEmissivity,
			state.foilEmissivity,
		);
		const customInput =
			options.surface.finish === 'custom'
